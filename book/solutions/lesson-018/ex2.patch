+// ClearBuffer — the naive fill again, but with an explicit wrap stop
+// this time (exercise 2): the loop ends when the offset turns negative.
 static void ClearBuffer(unsigned char *px, int nbytes, unsigned char v)
 {
-    for (int i = 0; i < nbytes; i++)
-        px[i] = v;
-    printf("clear covered %d bytes\n", nbytes);
+    int i = 0;
+    for (;;) {
+        if (i < nbytes)
+            px[i] = v;
+        i++;
+        if (i < 0) break;     /* stop when the offset wraps negative */
+    }
+    printf("clear ended at offset %d\n", i);
 }
 
