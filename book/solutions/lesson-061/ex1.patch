+/* The reader's inverses: numbers into little-endian bytes. */
+void PutU32(unsigned char *p, unsigned v)
+{
+    p[0] = (unsigned char)v;
+    p[1] = (unsigned char)(v >> 8);
+    p[2] = (unsigned char)(v >> 16);
+    p[3] = (unsigned char)(v >> 24);
+}
+
+void PutU16(unsigned char *p, unsigned v)
+{
+    p[0] = (unsigned char)v;
+    p[1] = (unsigned char)(v >> 8);
+}
+
+void PutTag(unsigned char *p, const char *id)
+{
+    for (int i = 0; i < 4; ++i)
+        p[i] = (unsigned char)id[i];
+}
+
+/* One sample frame, out the way ReadFrame takes it in: the count as two
+   little-endian bytes, its sign in bit 15. */
+void PutFrame(unsigned char *p, short frame)
+{
+    unsigned count = (unsigned short)frame; /* two's complement */
+    p[0] = (unsigned char)count;
+    p[1] = (unsigned char)(count >> 8);
+}
+
 } /* namespace */
 
