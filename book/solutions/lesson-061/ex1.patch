+bool WriteSample(Arena &arena, const char *path, const short *frames,
+                 int frame_count)
+{
+    /* The file is forty-four bytes of header and two bytes per frame.
+       The bytes are assembled in the arena as scratch — and the mark
+       takes them all back when the write is done, kept or refused. */
+    size_t mark = ArenaMark(arena);
+    size_t frames_bytes = (size_t)frame_count * 2;
+    size_t size = 44 + frames_bytes;
+    unsigned char *bytes = (unsigned char *)ArenaAlloc(arena, size, 1);
+    if (!bytes)
+        return false;
+
+    /* The header, byte by byte — exactly the fields LoadSample checks:
+       the container's claim about its own length, the format chunk's
+       facts, and the frames' own size. */
+    PutTag(bytes, "RIFF");
+    PutU32(bytes + 4, (unsigned)(size - 8));
+    PutTag(bytes + 8, "WAVE");
+    PutTag(bytes + 12, "fmt ");
+    PutU32(bytes + 16, 16);
+    PutU16(bytes + 20, 1); /* linear PCM */
+    PutU16(bytes + 22, 1); /* one channel */
+    PutU32(bytes + 24, (unsigned)AUDIO_RATE);
+    PutU32(bytes + 28, (unsigned)(AUDIO_RATE * 2)); /* the byte rate */
+    PutU16(bytes + 32, 2);                          /* the block align */
+    PutU16(bytes + 34, 16);                         /* the bits */
+    PutTag(bytes + 36, "data");
+    PutU32(bytes + 40, (unsigned)frames_bytes);
+
+    /* The frames: little-endian shorts, the reader's inverse. */
+    for (int i = 0; i < frame_count; ++i)
+        PutFrame(bytes + 44 + (size_t)i * 2, frames[i]);
+
+    platform::FileError error = platform::WriteFile(path, bytes, size);
+    ArenaRollback(arena, mark);
+    return error == platform::FILE_OK;
+}
+
 } /* namespace engine */
