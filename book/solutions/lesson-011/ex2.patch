+static int CmpByCountThenKey(const void *pa, const void *pb)
+{
+    const struct Item *a = (const struct Item *)pa;
+    const struct Item *b = (const struct Item *)pb;
+    if (a->value != b->value)
+        return a->value > b->value ? -1 : 1; // most frequent first
+    return strcmp(a->key, b->key);           // ties: alphabetical
+}
