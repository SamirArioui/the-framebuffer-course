+#!/usr/bin/env bash
+#
+# transcript-normalize.sh <transcript> — a run's reports, reduced to
+# their structure.
+#
+# Lesson 097's exercise 2: two runs of the same game are never
+# byte-identical — the measured numbers (times, positions, frame counts,
+# the pace's jitter) move between runs even when nothing about the game
+# changed. What must *not* move across a refactor is the structure: which
+# reports fired, what each says, and the order of first appearance. This
+# script strips the noise and keeps the structure, so two runs can be
+# diffed on what matters:
+#
+#   1. the harness's chatter goes (the Xvfb focus quirk, the ALSA probe),
+#   2. the per-frame log lines go (their count is the pace's, not the
+#      game's — the closing frame-budget table keeps the frame's cost),
+#   3. every digit becomes N, so measured values stop differing,
+#   4. repeated lines collapse to their first appearance, so a report
+#      that fired once and one that fired a hundred times read the same
+#      and two runs compare on the reports' shape.
+#
+# Usage:
+#   tools/transcript-normalize.sh run.log > run.shape
+#   diff run-a.shape run-b.shape
+#
+# Exits 0 always; the diff is the caller's evidence.
+
+set -euo pipefail
+
+grep -v -e 'XGetInputFocus' -e '^ALSA lib' "$1" \
+    | grep -v '^frame [0-9][0-9]*:' \
+    | sed -e 's/[0-9][0-9]*/N/g' -e 's/   */ /g' \
+    | awk '!seen[$0]++'
