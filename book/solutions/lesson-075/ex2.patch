+/* Exercise 2: the store's map — one character per slot: a live entity
+   is '#', a free slot is '.'. The map is where the store is, not how
+   many it holds. */
+static void PrintStoreMap(const EntityStore &store, const char *when)
+{
+    char map[ENTITY_CAP + 1];
+    for (int i = 0; i < ENTITY_CAP; ++i)
+        map[i] = store.slots[i].live ? '#' : '.';
+    map[ENTITY_CAP] = 0;
+    std::printf("engine: store map (%s): %s\n", when, map);
+}
