+/* Exercise 1: one walk over a scratch store, with a body that retires
+   one entity while standing at another — the contract's hard case, in
+   both directions. */
+static void ProbeWalk(const EntityTable &table, int at, int target)
+{
+    EntityStore store = {};
+    while (store.live < 6)
+        EntityCreate(store, table.rows[store.live % table.count]);
+    int visits[ENTITY_CAP];
+    int n = 0;
+    for (int i = 0; i < ENTITY_CAP; ++i) {
+        if (!store.slots[i].live)
+            continue;
+        visits[n++] = i;
+        if (i == at)
+            EntityRetire(store, store.slots[target]);
+    }
+    std::printf("engine: walk (retire slot %d at slot %d) visited", target, at);
+    for (int i = 0; i < n; ++i)
+        std::printf(" %d", visits[i]);
+    std::printf(", live %d\n", store.live);
+}
