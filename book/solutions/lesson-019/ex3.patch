 #include <stdio.h>
 #include <stdlib.h>
 
-static int running;              /* the loop runs while this is true */
-static unsigned long frame;      /* frames since the loop started */
-static unsigned long max_frames; /* stop after this many frames */
+struct Game {
+    int running;              /* the loop runs while this is true */
+    unsigned long frame;      /* frames since the loop started */
+    unsigned long max_frames; /* stop after this many frames */
+};
 
-static void ProcessInput(void)
+static void ProcessInput(struct Game *g)
 {
+    (void)g;
     // No keyboard yet — lesson 021 teaches the terminal.
 }
 
