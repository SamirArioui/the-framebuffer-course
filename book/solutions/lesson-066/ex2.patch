+void MixerPause(Mixer &mixer, int channel)
+{
+    /* Halt where it is: the cursor keeps its place and the mix stops
+       pulling — nothing is thrown away. */
+    if (channel >= 0 && channel < AUDIO_MIXER_CHANNELS)
+        mixer.channels[channel].active = false;
+}
+
+void MixerResume(Mixer &mixer, int channel)
+{
+    /* Carry on from exactly where the pause left the cursor. */
+    if (channel >= 0 && channel < AUDIO_MIXER_CHANNELS)
+        mixer.channels[channel].active = true;
+}
