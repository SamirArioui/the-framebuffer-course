@@ -5,6 +5,18 @@
 #include <stdio.h>
 #include <stdlib.h>
 
+// Exercise 3: make the growth rule measurable.
+#ifndef GROW_BY_ONE
+#define GROW_BY_ONE 1  // 1 = add one slot per growth, 0 = double
+#endif
+#ifndef BENCH_N
+#define BENCH_N 1000000
+#endif
+
+static unsigned long g_reallocs;
+static unsigned long g_model_elems; // elements the growth rule re-stores
+static unsigned long g_moved_elems; // elements really copied after a move
+
 struct Item {
     char key[16];
     long value;
@@ -26,12 +38,20 @@ void DaInit(struct DynArray *da)
 void DaPush(struct DynArray *da, struct Item item)
 {
     if (da->len == da->cap) {
+#if GROW_BY_ONE
+        size_t newcap = da->cap + 1;
+#else
         size_t newcap = da->cap ? da->cap * 2 : 4;
+#endif
         struct Item *p = realloc(da->items, newcap * sizeof *p);
         if (p == NULL) {
             fprintf(stderr, "DaPush: out of memory\n");
             exit(1);
         }
+        ++g_reallocs;
+        g_model_elems += da->len;
+        if (p != da->items)
+            g_moved_elems += da->len;
         da->items = p;
         da->cap = newcap;
     }
@@ -49,19 +69,15 @@ int main(void)
