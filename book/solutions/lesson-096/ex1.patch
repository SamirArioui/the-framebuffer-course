+/* Exercise 1: ClearBuffer's clipped rectangle — the same one color,
+   the same fold, one region. */
+void ClearRect(Framebuffer &fb, int x, int y, int w, int h,
+               unsigned char r, unsigned char g, unsigned char b)
+{
+    int left = x < 0 ? 0 : x;
+    int top = y < 0 ? 0 : y;
+    int right = x + w < fb.width ? x + w : fb.width;
+    int bottom = y + h < fb.height ? y + h : fb.height;
+    for (int j = top; j < bottom; ++j)
+        for (int i = left; i < right; ++i)
+            PutPixel(fb, i, j, r, g, b);
+}
+
