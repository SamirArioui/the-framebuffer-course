+// DrawLineFloat — the naive line: compute a slope, then one floating
+// point multiply per pixel.  What people write first — exercise 3.
+static void DrawLineFloat(unsigned char *px, int w, int h,
+                          int x0, int y0, int x1, int y1,
+                          unsigned char r, unsigned char g, unsigned char b)
+{
+    if (!ClipLine(&x0, &y0, &x1, &y1, w, h))
+        return;
+    if (x0 == x1) { /* the slope would divide by zero */
+        DrawLine(px, w, h, x0, y0, x1, y1, r, g, b);
+        return;
+    }
+    double slope = (double)(y1 - y0) / (double)(x1 - x0);
+    int sx = x0 < x1 ? 1 : -1;
+    for (int x = x0;; x += sx) {
+        int y = y0 + (int)(slope * (x - x0));
+        PutPixel(px, w, h, x, y, r, g, b);
+        if (x == x1) break;
+    }
+}
