     DrawLine(pixels, W, H, 4, -2, 4, 9, 255, 0, 255);   /* magenta vertical */
 
+    /* The rectangle outline, hanging off the left edge. */
+    DrawRect(pixels, W, H, -2, 1, 6, 4, 96, 96, 96);
