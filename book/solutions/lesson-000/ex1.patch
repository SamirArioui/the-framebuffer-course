diff --git a/src/draw.c b/src/draw.c
--- a/src/draw.c
+++ b/src/draw.c
@@ -22,0 +23,19 @@
+// FillRectangleOutline: draw only the border of a rectangle.
+void FillRectangleOutline(Framebuffer *fb, Rectangle r, int thickness, Color color)
+{
+    Rectangle top    = { r.x, r.y, r.w, thickness };
+    Rectangle bottom = { r.x, r.y + r.h - thickness, r.w, thickness };
+    Rectangle left   = { r.x, r.y, thickness, r.h };
+    Rectangle right  = { r.x + r.w - thickness, r.y, thickness, r.h };
+
+    FillRectangle(fb, top, color);
+    FillRectangle(fb, bottom, color);
+    FillRectangle(fb, left, color);
+    FillRectangle(fb, right, color);
+}
