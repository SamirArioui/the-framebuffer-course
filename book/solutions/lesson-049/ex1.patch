+/* Exercise 1: the same shape as ClearBuffer's loop — four distinct bytes
+   per pixel — as a named function the census can find. Predict before
+   you run: does this vectorize, and why? */
+void FillPattern(unsigned char *dst, size_t n, unsigned char a,
+                 unsigned char b, unsigned char c)
+{
+    for (size_t i = 0; i < n; i += 4) {
+        dst[i + 0] = a;
+        dst[i + 1] = b;
+        dst[i + 2] = c;
+        dst[i + 3] = 0;
+    }
+}
+
+/* Exercise 1's contrast: one byte value, everywhere. */
+void FillUniform(unsigned char *dst, size_t n, unsigned char v)
+{
+    for (size_t i = 0; i < n; ++i)
+        dst[i] = v;
+}
