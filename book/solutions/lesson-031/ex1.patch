+bool PresentedMatches(Window *window, const unsigned char *pixels,
+                      int width, int height)
+{
+    if (!window || !window->display || !window->xwindow)
+        return false;
+
+    XImage *image = XGetImage(window->display, window->xwindow, 0, 0,
+                              width, height, AllPlanes, ZPixmap);
+    if (!image)
+        return false;
+
+    bool match = true;
+    for (int y = 0; y < height && match; ++y) {
+        for (int px = 0; px < width; ++px) {
+            unsigned long got = XGetPixel(image, px, y) & 0xFFFFFFUL;
+            const unsigned char *p = pixels + (y * width + px) * 4;
+            unsigned long want = (unsigned long)p[0] |
+                                 ((unsigned long)p[1] << 8) |
+                                 ((unsigned long)p[2] << 16);
+            if (got != want) {
+                match = false;
+                break;
+            }
+        }
+    }
+    XDestroyImage(image); /* the readback's bytes are Xlib's to free */
+    return match;
+}
