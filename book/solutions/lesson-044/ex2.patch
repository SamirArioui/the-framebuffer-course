+/* The sprite, drawn with the raw loop lesson 045 turns into the blitter:
+   every pixel copied, key color and all. */
+static void DrawSpriteRaw(Framebuffer &fb, const Sprite &s, int x, int y)
+{
+    for (int j = 0; j < s.height; ++j)
+        for (int i = 0; i < s.width; ++i) {
+            const unsigned char *p = &s.pixels[(j * s.width + i) * 3];
+            PutPixel(fb, x + i, y + j, p[0], p[1], p[2]);
+        }
+}
