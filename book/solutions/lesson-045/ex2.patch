+/* One clip case: draw at (x, y) and count what landed, what landed wrong,
+   and what got touched outside the landed rectangle. */
+static void CheckClip(Framebuffer &fb, const Sprite &s, int x, int y)
+{
+    ClearBuffer(fb, 32, 32, 64);
+    BlitSprite(fb, s, x, y);
+
+    /* The landed rectangle: the sprite's box crossed with the frame. */
+    int left = x < 0 ? 0 : x;
+    int top = y < 0 ? 0 : y;
+    int right = x + s.width < fb.width ? x + s.width : fb.width;
+    int bottom = y + s.height < fb.height ? y + s.height : fb.height;
+
+    int landed = 0, wrong = 0, touched = 0;
+    for (int j = top; j < bottom; ++j)
+        for (int i = left; i < right; ++i) {
+            const unsigned char *p =
+                &s.pixels[(((j - y) * s.width) + (i - x)) * 3];
+            unsigned char r, g, b;
+            GetPixel(fb, i, j, r, g, b);
+            ++landed;
+            bool is_key = p[0] == s.key_r && p[1] == s.key_g &&
+                          p[2] == s.key_b;
+            if (is_key ? (r != 32 || g != 32 || b != 64)
+                       : (r != p[0] || g != p[1] || b != p[2]))
+                ++wrong;
+        }
+    for (int yy = 0; yy < fb.height; ++yy)
+        for (int xx = 0; xx < fb.width; ++xx) {
+            if (xx >= left && xx < right && yy >= top && yy < bottom)
+                continue;
+            unsigned char r, g, b;
+            GetPixel(fb, xx, yy, r, g, b);
+            if (r != 32 || g != 32 || b != 64)
+                ++touched;
+        }
+    std::printf("engine: clip (%d,%d): %d pixels landed, %d wrong, %d touched outside\n",
+                x, y, landed, wrong, touched);
+}
