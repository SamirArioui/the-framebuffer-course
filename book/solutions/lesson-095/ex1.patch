@@ -23,33 +24,53 @@ void SoundStart(Sound &sound)
                 AUDIO_VOLUME_FULL);
 }
 
-/* One event's sound: its sample on the pool's channels, at its volume,
+/* Exercise 1: the loudness follows the distance — full at the hero's
+   ear, fading to nothing at the falloff's edge. The falloff is
+   quadratic in the squared distance: no square root runs to mix a
+   sound. */
+static int Loudness(double dx, double dy, int base)
+{
+    constexpr double FADE = 256.0; /* pixels: silence at this distance */
+    double d2 = dx * dx + dy * dy;
+    double f2 = FADE * FADE;
+    if (d2 >= f2)
+        return 0;
+    return (int)(base * (1.0 - d2 / f2));
+}
+
+/* One event's sound: its sample on the pool's channels, at its loudness,
    reported with the channel it landed on. The volumes are the sounds'
    own — a quiet blip for every shot, a heavier thud for a hit, the
-   loudest for a death — so the mix inside the format stays honest while
-   the game gets loud. */
-static void Fire(Sound &sound, const Sample &sample, int volume,
-                 const char *what)
+   loudest for a death — scaled by the event's distance, so the mix
+   inside the format stays honest while the game gets loud. */
+static void Fire(Sound &sound, const Sample &sample, int base, double dx,
+                 double dy, const char *what)
 {
+    int volume = Loudness(dx, dy, base);
+    if (volume <= 0) {
+        std::printf("engine: sound: %s — silent at %d px\n", what,
+                    (int)std::sqrt(dx * dx + dy * dy));
+        return;
+    }
     int ch = MixerPlayEffect(sound.mixer, sample, volume);
     sound.fired += 1;
     std::printf("engine: sound: %s -> channel %d (volume %d of %d)\n", what,
                 ch, volume, AUDIO_VOLUME_FULL);
 }
 
-void SoundShot(Sound &sound)
+void SoundShot(Sound &sound, double dx, double dy)
 {
-    Fire(sound, sound.shot, AUDIO_VOLUME_FULL / 4, "shot");
+    Fire(sound, sound.shot, AUDIO_VOLUME_FULL / 4, dx, dy, "shot");
 }
 
-void SoundHit(Sound &sound)
+void SoundHit(Sound &sound, double dx, double dy)
 {
-    Fire(sound, sound.hit, AUDIO_VOLUME_FULL / 2, "hit");
+    Fire(sound, sound.hit, AUDIO_VOLUME_FULL / 2, dx, dy, "hit");
 }
 
-void SoundDeath(Sound &sound)
+void SoundDeath(Sound &sound, double dx, double dy)
 {
-    Fire(sound, sound.death, AUDIO_VOLUME_FULL / 2, "death");
+    Fire(sound, sound.death, AUDIO_VOLUME_FULL / 2, dx, dy, "death");
 }
 
 } /* namespace engine */
