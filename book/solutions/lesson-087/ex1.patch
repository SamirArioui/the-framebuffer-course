     /* The rate is the row's, in rounds per minute: the trigger answers
        again only when the cooldown it earns has run out. At most one
@@ -104,8 +106,31 @@ void HeroFire(Entity &hero, platform::Window *window,
         else
             dir_y = -1.0;
     }
-    if (CombatFire(store, shots, hero, dir_x, dir_y))
-        hero.cooldown = 60.0 / (double)hero.rate;
+    /* Exercise 1: the scatter gun — one trigger pull fires `burst`
+       shots: the middle along the aim and the spread's others turned
+       one 45-degree step at a time to either side. A turn of a unit
+       direction by 45 degrees — ((x-y)/sqrt(2), (x+y)/sqrt(2)) — keeps
+       its length, so every shot of the spread flies at the shot's own
+       speed. */
+    double cw_x = dir_x, cw_y = dir_y;
+    double ccw_x = dir_x, ccw_y = dir_y;
+    for (int i = 0; i < hero.burst; ++i) {
+        if (i == 0) {
+            CombatFire(store, shots, hero, dir_x, dir_y);
+            continue;
+        }
+        double nx = (cw_x - cw_y) * AIM_DIAG, ny = (cw_x + cw_y) * AIM_DIAG;
+        cw_x = nx;
+        cw_y = ny;
+        double mx = (ccw_x + ccw_y) * AIM_DIAG, my = (ccw_y - ccw_x) * AIM_DIAG;
+        ccw_x = mx;
+        ccw_y = my;
+        if (i % 2)
+            CombatFire(store, shots, hero, cw_x, cw_y);
+        else
+            CombatFire(store, shots, hero, ccw_x, ccw_y);
+    }
+    hero.cooldown = 60.0 / (double)hero.rate;
 }
 
