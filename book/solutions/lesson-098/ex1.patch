diff --git a/src/report.cpp b/src/report.cpp
index 425fe4d..38fbe6d 100644
--- a/src/report.cpp
+++ b/src/report.cpp
@@ -104,4 +104,22 @@ void ReportEnd(const Sound &sound, const Feed &feed,
                 walk_visits, frames);
 }
 
+void ReportSeam(const FrameStats &stats)
+{
+    /* Exercise 1: the frame's wall time in two buckets. The engine's
+       work is what the process computed — the phases the flat profile
+       samples. The seam's wait is the present: the wall time between
+       handing the display our pixels and being handed back, which is
+       the display's time, not ours. A profile that samples the process
+       cannot see it; this line can. */
+    if (!stats.frames)
+        return;
+    double n = (double)stats.frames;
+    double engine_ms =
+        (stats.update_sum + stats.audio_sum + stats.render_sum) / n * 1e3;
+    double seam_ms = stats.present_sum / n * 1e3;
+    std::printf("engine: seam: %ld frames — engine work %.3f ms/frame (update+audio+render), seam wait %.3f ms/frame (present) — the flat profile sees the first, not the second\n",
+                stats.frames, engine_ms, seam_ms);
+}
+
 } /* namespace engine */
