     std::printf("engine: map check: %d cells, %d unknown, %d of 2 corners solid\n",
                 map.width * map.height, unknown, solid_corners);
 
+    /* Exercise 2: the map as characters — a debug view through DrawText,
+       and two rows read back against the file's own rows. */
+    ClearBuffer(*fb, 32, 32, 64);
+    char row_chars[TILE_MAX_DIM + 1];
+    for (int y = 0; y < map.height; ++y) {
+        for (int x = 0; x < map.width; ++x) {
+            int kind = TileAt(map, x, y);
+            row_chars[x] = kind >= 0 ? map.kinds[kind].cell : '?';
+        }
+        row_chars[map.width] = 0;
+        DrawText(*fb, font, row_chars, 32, 32 + y * FONT_CELL);
+    }
+    {
+        int view_rows[2] = { 0, 1 };
+        for (int vr = 0; vr < 2; ++vr) {
+            int ink_pixels = 0;
+            for (int s = 0; s < map.width; ++s)
+                for (int j = 0; j < FONT_CELL; ++j)
+                    for (int i = 0; i < FONT_CELL; ++i) {
+                        unsigned char r, g, b;
+                        GetPixel(*fb, 32 + s * FONT_CELL + i,
+                                 32 + view_rows[vr] * FONT_CELL + j, r, g, b);
+                        if (r != 32 || g != 32 || b != 64)
+                            ++ink_pixels;
+                    }
+            std::printf("engine: map view: row %d draws %d ink pixels\n",
+                        view_rows[vr], ink_pixels);
+        }
+    }
