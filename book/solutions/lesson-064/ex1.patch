+    /* Exercise 1: the clamp's footprint. The whole sample, frame by
+       frame, through the engine's own MixBuffer on a scratch mixer —
+       five channels at full volume — and every frame the clamp changes
+       is named (the first few) and counted (all of them). */
+    Mixer probe;
+    MixerInit(probe);
+    for (int c = 0; c < 5; ++c)
+        ChannelPlay(probe.channels[c], sample, AUDIO_VOLUME_FULL);
+    int clamped = 0;
+    for (int at = 0; at < sample.frame_count; ++at) {
+        short one = 0;
+        MixBuffer(probe, &one, 1);
+        int sum = 5 * sample.frames[at * sample.channels];
+        if (sum == (int)one)
+            continue;
+        clamped += 1;
+        if (clamped <= 6) {
+            /* What a wrapping accumulator — the sum truncated to the
+               format's 16 bits — would have put in the stream instead. */
+            int wrapped = sum > 32767 ? sum - 65536 : sum + 65536;
+            std::printf("engine: clamp: frame %d: sum %d -> out %d, wrapped %d\n",
+                        at, sum, (int)one, wrapped);
+        }
+    }
+    std::printf("engine: clamp: %d of %d frames clamped\n", clamped,
