+namespace {
+
+/* Exercise 2: one whole number, digit by digit, into the image. */
+int PutInt(unsigned char *out, int at, int value)
+{
+    char digits[16];
+    int n = 0;
+    do {
+        digits[n++] = (char)('0' + value % 10);
+        value /= 10;
+    } while (value > 0);
+    while (n > 0)
+        out[at++] = (unsigned char)digits[--n];
+    return at;
+}
+
+/* Exercise 2: one text value — the bytes it has, and the space after. */
+int PutText(unsigned char *out, int at, const char *text)
+{
+    int i = 0;
+    while (text[i]) {
+        out[at++] = (unsigned char)text[i];
+        ++i;
+    }
+    return at;
+}
+
+} /* namespace */
+
+platform::FileError WriteTable(Arena &arena, const char *path,
+                               const EntityTable &table)
+{
+    /* The image is scratch: a bound over the widest possible header and
+       row, never a guess about the actual one — the bytes handed to the
+       write are exactly the ones assembled, and the arena takes the
+       bound back either way. */
+    size_t mark = ArenaMark(arena);
+    size_t bound = 64 + (size_t)table.count * 128;
+    unsigned char *image = (unsigned char *)ArenaAlloc(arena, bound, 1);
+    if (!image)
+        return platform::FILE_UNWRITABLE;
+
+    static const char *const HEADER[COL_COUNT] = {
+        "name", "x", "y", "facing", "speed", "health", "sprite"
+    };
+    int at = 0;
+    for (int c = 0; c < COL_COUNT; ++c) {
+        at = PutText(image, at, HEADER[c]);
+        image[at++] = (unsigned char)(c + 1 == COL_COUNT ? '\n' : ' ');
+    }
+    for (int i = 0; i < table.count; ++i) {
+        const EntityDef &def = table.rows[i];
+        at = PutText(image, at, def.name);
+        image[at++] = ' ';
+        at = PutInt(image, at, def.x);
+        image[at++] = ' ';
+        at = PutInt(image, at, def.y);
+        image[at++] = ' ';
+        at = PutInt(image, at, def.facing);
+        image[at++] = ' ';
+        at = PutInt(image, at, def.speed);
+        image[at++] = ' ';
+        at = PutInt(image, at, def.health);
+        image[at++] = ' ';
+        at = PutText(image, at, def.sprite);
+        image[at++] = '\n';
+    }
+
+    platform::FileError error = platform::WriteFile(path, image, (size_t)at);
+    ArenaRollback(arena, mark); /* kept or refused, the image is scratch */
+    return error;
+}
+
 } /* namespace engine */
