+/* Lesson 101: the 60 fps frame — the budget the finished game is
+   measured against (the MVD's perf line). One sixtieth of a second. */
+constexpr double FRAME_BUDGET_MS = 1000.0 / 60.0;
+
+/* Exercise 1: the histogram's grain — buckets of a quarter millisecond
+   out to 16 ms (64 of them), the last one an overflow pail. */
+constexpr double FRAME_BUCKET_MS = 0.25;
+constexpr int FRAME_HISTOGRAM = 64;
+
 /* The running account: every frame measured so far. */
