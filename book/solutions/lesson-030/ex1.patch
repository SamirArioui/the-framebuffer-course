+void FillRect(Framebuffer &fb, int x, int y, int w, int h,
+              unsigned char r, unsigned char g, unsigned char b)
+{
+    /* Fold first (lesson 015): the clip happens in rectangle space, so one
+       check replaces one check per pixel. */
+    int x0 = x < 0 ? 0 : x;
+    int y0 = y < 0 ? 0 : y;
+    int x1 = x + w > fb.width ? fb.width : x + w;
+    int y1 = y + h > fb.height ? fb.height : y + h;
+
+    for (int py = y0; py < y1; ++py)
+        for (int px = x0; px < x1; ++px)
+            PutPixel(fb, px, py, r, g, b);
+}
+
 void GetPixel(const Framebuffer &fb, int x, int y, unsigned char &r,
               unsigned char &g, unsigned char &b)
 {
