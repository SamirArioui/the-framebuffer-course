+int MixerPlayEffectSolo(Mixer &mixer, const Sample &sample, int volume)
+{
+    /* The gate before the route: if this sample is already sounding on
+       some effect channel, there is no second copy to start. */
+    for (int c = AUDIO_MUSIC_CHANNEL + 1; c < AUDIO_MIXER_CHANNELS; ++c) {
+        if (mixer.channels[c].active && mixer.channels[c].sample == &sample)
+            return AUDIO_ALREADY_PLAYING;
+    }
+    return MixerPlayEffect(mixer, sample, volume);
+}
