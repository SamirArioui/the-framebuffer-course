diff --git a/sandbox/ds-kit/hashtable.c b/sandbox/ds-kit/hashtable.c
index faac93c..f8502cb 100644
--- a/sandbox/ds-kit/hashtable.c
+++ b/sandbox/ds-kit/hashtable.c
@@ -84,3 +84,17 @@ void HtFree(struct HashTable *ht)
     ht->nbuckets = 0;
     ht->len = 0;
 }
+
+void HtStats(const struct HashTable *ht)
+{
+    size_t empty = 0, longest = 0;
+    for (size_t b = 0; b < ht->nbuckets; ++b) {
+        size_t n = ht->chains[b].len;
+        if (n == 0)
+            ++empty;
+        if (n > longest)
+            longest = n;
+    }
+    fprintf(stderr, "stats: entries=%zu buckets=%zu empty=%zu longest=%zu\n",
+            ht->len, ht->nbuckets, empty, longest);
+}
