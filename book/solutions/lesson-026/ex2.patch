+// engine.h — the engine's contract with its own entry point.
+//
+// Lesson 026, exercise 2: a header is a contract between translation units.
+// Everything here is what `main.cpp` may rely on.
+#ifndef ENGINE_H
+#define ENGINE_H
+
+namespace engine {
+
+int Run(void);
+
+} /* namespace engine */
+
+#endif
