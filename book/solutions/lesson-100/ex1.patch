                 walk_visits, frames);
 }
 
+void ReportClearBench(const Framebuffer &fb)
+{
+    /* Exercise 1: the bench, in the tradition of lesson 048's sprite
+       bench: the clear timed at three sizes over 200 clears each, so
+       the price per pixel is visible apart from the frame's other
+       work. The views share the real buffer — the clear is the same
+       clear on less memory. */
+    const int sizes[3][2] = { { 640, 480 }, { 320, 240 }, { 160, 120 } };
+    for (int s = 0; s < 3; ++s) {
+        Framebuffer view = { fb.pixels, sizes[s][0], sizes[s][1] };
+        double t0 = platform::Now();
+        for (int rep = 0; rep < 200; ++rep)
+            ClearBuffer(view, 32, 32, 64);
+        double dt = platform::Now() - t0;
+        std::printf("engine: bench: clear %dx%d — %.1f ns/pixel over %d clears\n",
+                    sizes[s][0], sizes[s][1],
+                    dt * 1e9 /
+                        ((double)sizes[s][0] * (double)sizes[s][1] * 200.0),
+                    200);
+    }
+}
+
 } /* namespace engine */
