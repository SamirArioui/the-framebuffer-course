+/* Exercise 2: the window's account — what a frame cost at the scale the
+   window ran at. The window closes when the knob turns. */
+struct ScaleWindow {
+    int frames;
+    double total;
+    double scale;
+};
+
+static void PrintWindow(ScaleWindow &window, const char *label)
+{
+    if (window.frames > 0)
+        std::printf("engine: window (%s): %d frames at scale %.2f averaged %.3f ms of wall clock\n",
+                    label, window.frames, window.scale,
+                    window.total / window.frames * 1e3);
+    window.frames = 0;
+    window.total = 0.0;
+}
