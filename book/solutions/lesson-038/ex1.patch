 namespace engine {
 
+/* Lesson 017's image file by hand: PPM is a tiny header, then RGB bytes. */
+static bool SaveScreenshot(const char *path, Framebuffer &fb)
+{
+    static unsigned char out[64 + 640 * 480 * 3];
+    int n = std::snprintf((char *)out, sizeof out, "P6\n%d %d\n255\n",
+                          fb.width, fb.height);
+    unsigned char *rgb = out + n;
+    for (int y = 0; y < fb.height; ++y) {
+        for (int x = 0; x < fb.width; ++x) {
+            unsigned char r, g, b;
+            GetPixel(fb, x, y, r, g, b);
+            *rgb++ = r;
+            *rgb++ = g;
+            *rgb++ = b;
+        }
+    }
+    return platform::WriteFile(path, out, (size_t)(rgb - out)) ==
+           platform::FILE_OK;
+}
