diff --git a/src/frame.h b/src/frame.h
index 3ca1cdb..2635d56 100644
--- a/src/frame.h
+++ b/src/frame.h
@@ -28,8 +28,13 @@ struct FrameStats {
     double total_sum;
     double worst;      /* the longest frame so far */
     long worst_number; /* and which one it was */
+    long within_budget;/* frames that fit the budget below */
 };
 
+/* The frame budget: how long a frame may take. Part 5 turns this number
+   into a report; for now it is the 60 fps line — 16.7 ms. */
+constexpr double FRAME_BUDGET = 1.0 / 60.0;
+
 void AccountFrame(FrameStats &stats, const FrameRecord &frame);
 
 } /* namespace engine */
