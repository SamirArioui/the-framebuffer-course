+FileData ReadFileInto(const char *path, unsigned char *into, size_t capacity)
+{
+    FileData file = { into, 0, FILE_UNREADABLE };
+
+    int fd = open(path, O_RDONLY);
+    if (fd < 0) {
+        file.data = 0;
+        file.error = (errno == ENOENT) ? FILE_NOT_FOUND : FILE_UNREADABLE;
+        return file;
+    }
+
+    size_t total = 0;
+    for (;;) {
+        ssize_t n = read(fd, into + total, capacity - total);
+        if (n < 0) {
+            close(fd);
+            file.data = 0;
+            return file;
+        }
+        if (n == 0)
+            break;
+        total += (size_t)n;
+        if (total == capacity) { /* no room left: is the file over? */
+            unsigned char extra;
+            if (read(fd, &extra, 1) != 0) {
+                close(fd);
+                file.data = 0;
+                return file; /* it did not fit */
+            }
+            break;
+        }
+    }
+
+    close(fd);
+    file.size = total;
+    file.error = FILE_OK;
+    return file;
+}
